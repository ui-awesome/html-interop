{
    "name": "ui-awesome/html-interop",
    "type": "library",
    "description": "Shared backed enums classifying HTML elements by category (block, inline, list, table, void, metadata, root) for the UI Awesome ecosystem.",
    "keywords": [
        "ui-awesome",
        "html",
        "html-interop",
        "enums",
        "backed-enums",
        "block",
        "inline",
        "list",
        "table",
        "void",
        "metadata",
        "php"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/baseline": "^0.1",
        "php-forge/coding-standard": "^0.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5",
        "yii2-extensions/scaffold": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "UIAwesome\\Html\\Interop\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UIAwesome\\Html\\Interop\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        },
        "scaffold": {
            "allowed-packages": [
                "php-forge/baseline",
                "php-forge/coding-standard"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yii2-extensions/scaffold": true
        }
    },
    "scripts": {
        "ecs": "./vendor/bin/ecs --fix",
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit"
    }
}
